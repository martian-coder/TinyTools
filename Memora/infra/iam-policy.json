{
  "Comment": "Attach this inline policy to the Lambda execution role (alongside AWSLambdaBasicExecutionRole).",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MemoraMemoryTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/MemoraMemory"
    }
  ]
}
