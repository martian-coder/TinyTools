# ─────────────────────────────────────────────────────────────
# Stealth Meeting Assistant — copy to .env and fill what you use
# Any provider whose key is missing simply shows as "unavailable".
# ─────────────────────────────────────────────────────────────

DEFAULT_PROVIDER=
DEFAULT_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ── Local runtime ────────────────────────────────────────────
# Backend port (loopback only, never bound to 0.0.0.0)
PORT=5173

# Where documents, embeddings and the session token live
# DATA_DIR=./data

# ── Embeddings ───────────────────────────────────────────────
# local  = Transformers.js, on-device, no network            (default)
# api    = OpenAI-compatible /embeddings endpoint
# hash   = deterministic fallback, no model download, low quality
EMBEDDINGS_MODE=local
EMBEDDINGS_LOCAL_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_API_PROVIDER=openai
EMBEDDINGS_API_MODEL=text-embedding-3-small

# ── Retrieval tuning ─────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25
CHUNK_TARGET_TOKENS=900
CHUNK_OVERLAP_TOKENS=100

# ── API auth ─────────────────────────────────────────────────
# A token is generated at startup and written to data/session-token.txt so
# other local processes (e.g. an STT bridge) can post transcript events.
# Set ASSISTANT_AUTH=off only if you are scripting against it and understand
# that any local process could then reach the API.
ASSISTANT_AUTH=on
