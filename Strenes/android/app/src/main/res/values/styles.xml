<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- android:background is the legacy path Theme.SplashScreen's AndroidX
             compat shim uses pre-Android 12. On Android 12+, the system splash
             API ignores it and needs windowSplashScreenBackground explicitly —
             without it, unset here before, the OS fell back to a default (often
             white) background instead of the brand's dark navy. The launcher
             icon (already the branded green/white mark) is used automatically
             since no windowSplashScreenAnimatedIcon override is set. -->
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">#0b1020</item>
    </style>
</resources>